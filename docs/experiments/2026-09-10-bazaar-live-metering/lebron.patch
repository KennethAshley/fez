diff --git a/invoice.mjs b/invoice.mjs
index 1844724..b6f5dee 100644
--- a/invoice.mjs
+++ b/invoice.mjs
@@ -3,10 +3,18 @@ export function invoiceBalance(invoiceCents, payments) {
     throw new TypeError("invalid invoice amount");
   }
   let paid = 0;
+  const seen = new Map();
   for (const payment of payments) {
     if (!payment || typeof payment.ref !== "string" || !payment.ref.trim() || !Number.isSafeInteger(payment.cents)) {
       throw new TypeError("invalid payment");
     }
+    if (seen.has(payment.ref)) {
+      if (seen.get(payment.ref) !== payment.cents) {
+        throw new TypeError("conflicting payment reference");
+      }
+      continue;
+    }
+    seen.set(payment.ref, payment.cents);
     paid += payment.cents;
   }
   return invoiceCents - paid;
diff --git a/invoice.test.mjs b/invoice.test.mjs
index 82b1368..0f726e7 100644
--- a/invoice.test.mjs
+++ b/invoice.test.mjs
@@ -15,3 +15,13 @@ test("malformed inputs are rejected", () => {
 test("re-importing the same payment does not charge it twice", () => {
   assert.equal(invoiceBalance(12500, [{ ref: "P1", cents: 5000 }, { ref: "P1", cents: 5000 }]), 7500);
 });
+test("conflicting amounts for the same reference throw", () => {
+  assert.throws(() => invoiceBalance(12500, [{ ref: "P1", cents: 5000 }, { ref: "P1", cents: 6000 }]), TypeError);
+});
+test("re-importing the same refund does not credit it twice", () => {
+  assert.equal(invoiceBalance(12500, [{ ref: "pay", cents: 5000 }, { ref: "refund", cents: -1000 }, { ref: "refund", cents: -1000 }]), 8500);
+  assert.throws(() => invoiceBalance(12500, [{ ref: "refund", cents: -1000 }, { ref: "refund", cents: -2000 }]), TypeError);
+});
+test("distinct references with equal amounts are separate transactions", () => {
+  assert.equal(invoiceBalance(12500, [{ ref: "P1", cents: 5000 }, { ref: "P2", cents: 5000 }]), 2500);
+});
