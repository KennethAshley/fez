{
  "name": "@fezchat/ridges",
  "version": "0.1.0",
  "private": true,
  "description": "The first paid-service extension for fez — /ridges <issue-url> pays the Ridges subnet through the wallet's x402 rail and tracks the resulting PR.",
  "type": "module",
  "fez": {
    "type": "extension",
    "parts": {
      "headless": "dist/headless.js",
      "miner": "dist/miner.js",
      "skill": {
        "command": "node",
        "args": ["dist/mcp.js"]
      },
      "background": true
    },
    "permissions": [
      "network:product.ridges.ai",
      "network:agent-upload.ridges.ai",
      "processes",
      "network:api.github.com",
      "read:channels",
      "publish",
      "commands",
      "background"
    ],
    "minFezVersion": "0.2.0"
  },
  "scripts": {
    "build": "esbuild src/headless.ts src/mcp.ts src/miner.ts --bundle --format=esm --platform=node --outdir=dist",
    "check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@fezchat/wallet": "file:../fez-wallet",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@fezchat/protocol": "file:../..",
    "@fezchat/extension-api": "file:../fez-extension-api",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist"
  ]
}
