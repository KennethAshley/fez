{
  "name": "@fez/bittensor-taostats",
  "version": "0.1.0",
  "description": "Fez agent for Bittensor subnet mining via taostats.io — discovers subnets, inspects repos, and orchestrates Docker miners",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@fez/protocol": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "fez": {
    "type": "agent",
    "agent": {
      "entry": "dist/agent.js",
      "supportedTasks": [
        "bittensor.list_subnets",
        "bittensor.subnet_info",
        "bittensor.inspect_miner",
        "bittensor.start_miner",
        "bittensor.stop_miner",
        "bittensor.register_wallet"
      ]
    }
  },
  "keywords": ["fez-package", "agent", "bittensor", "taostats", "mining"],
  "license": "MIT"
}
