{
  "name": "@fezchat/ditto",
  "version": "0.1.0",
  "private": true,
  "description": "Connect selected Fez agents to Ditto memory: search, fetch, and explicitly save notes.",
  "type": "module",
  "fez": {
    "type": "extension",
    "parts": {
      "skill": {
        "command": "node",
        "args": ["dist/mcp.js"],
        "env": { "DITTO_API_KEY": "" }
      }
    },
    "permissions": ["network:api.heyditto.ai"]
  },
  "scripts": {
    "build": "esbuild src/mcp.ts --bundle --format=esm --platform=node --banner:js=\"import{createRequire as ___cr}from'node:module';const require=___cr(import.meta.url);\" --outfile=dist/mcp.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  },
  "files": ["dist"]
}
