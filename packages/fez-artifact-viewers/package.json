{
  "name": "@fezchat/artifact-viewers",
  "version": "0.1.0",
  "description": "Viewers for fez kind-40300 artifacts — the registry and the portable built-ins (html, image, pdf, markdown, table), shared by fez-desktop and the fez.chat share pages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
