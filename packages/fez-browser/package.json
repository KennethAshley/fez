{
  "name": "@fezchat/browser",
  "version": "0.1.1",
  "private": true,
  "description": "Visible native browser panes and anonymous browser reading tools for Fez agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "fez": {
    "type": "extension",
    "parts": {
      "skill": {
        "command": "node",
        "args": [
          "dist/mcp.js"
        ],
        "env": {
          "CAMOFOX_BASE_URL": "",
          "CAMOFOX_ACCESS_KEY": ""
        }
      },
      "gui": "dist/gui.js"
    },
    "permissions": [
      "network:*",
      "ui",
      "processes",
      "commands"
    ],
    "minFezVersion": "0.2.0"
  },
  "scripts": {
    "build": "esbuild src/mcp.ts src/index.ts src/cli.ts --bundle --format=esm --platform=node --banner:js=\"import{createRequire as ___cr}from'module';const require=___cr(import.meta.url);\" --outdir=dist && esbuild src/gui.ts --bundle --format=iife --global-name=__fezExt --platform=browser --loader:.css=text --outfile=dist/gui.js && tsc -p tsconfig.types.json",
    "check": "tsc --noEmit",
    "test": "npm test --prefix ../fez-evals -- tests/browser.test.ts tests/browser-runtime.test.ts tests/browser-gui.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@fezchat/extension-api": "file:../fez-extension-api",
    "@types/react": "^19.1.8",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  },
  "bin": {
    "fez-browser": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KennethAshley/fez.git",
    "directory": "packages/fez-browser"
  },
  "homepage": "https://github.com/KennethAshley/fez/tree/main/packages/fez-browser#readme"
}
