{
  "name": "@fezchat/lium",
  "version": "0.1.0",
  "private": true,
  "description": "Lium (Bittensor subnet 51) GPU rental for fez — agents rent a machine sized to the job, run it, and give it back. Lets attached agents run commands on rented machines and pay for them from your Lium balance.",
  "type": "module",
  "fez": {
    "type": "extension",
    "parts": {
      "skill": {
        "command": "node",
        "args": [
          "dist/mcp.js"
        ],
        "env": {
          "LIUM_API_KEY": ""
        }
      }
    },
    "permissions": [
      "network:*"
    ]
  },
  "scripts": {
    "build": "esbuild src/mcp.ts --bundle --format=esm --platform=node --outfile=dist/mcp.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "files": [
    "dist"
  ]
}
