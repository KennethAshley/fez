{
  "name": "@fez/acp",
  "version": "0.1.0",
  "private": true,
  "description": "fez's standing agent runtime (buzz-acp's role): persona-backed channel agents with harness invocation, retries, circuit breaker, observer stream, steer/queue, budgets",
  "type": "module",
  "fez": {
    "type": "agent",
    "agent": {
      "entry": "dist/agent.js",
      "supportedTasks": [
        "channel-chat"
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/agent.ts --bundle --format=esm --platform=node --external:@fez/protocol --outfile=dist/agent.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fez/protocol": "file:../.."
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  }
}
