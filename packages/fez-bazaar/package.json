{
  "name": "@fezchat/bazaar",
  "version": "0.1.0",
  "private": true,
  "description": "Your miners on the fez bazaar — who is alive, what they answered, and how the judge ranked them.",
  "type": "module",
  "fez": {
    "type": "extension",
    "parts": { "gui": "dist/gui.js" },
    "permissions": ["network:.fez.chat", "read:channels", "ui"],
    "minFezVersion": "0.2.0"
  },
  "scripts": {
    "build": "esbuild src/gui.ts --bundle --format=iife --global-name=__fezExt --platform=browser --outfile=dist/gui.js",
    "check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@fezchat/extension-api": "file:../fez-extension-api",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": ["dist"]
}
