{
  "name": "@fezchat/media",
  "version": "0.1.0",
  "private": true,
  "description": "Media for fez — /upload files to any Blossom server (BUD-02 signed auth), share the URL in-channel. Pure client-side; the relay never sees a byte.",
  "type": "module",
  "fez": { "type": "extension", "extension": { "entry": "dist/index.js" } },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js && esbuild src/blossom.ts --bundle --format=esm --platform=node --outfile=dist/blossom.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": { "esbuild": "^0.21.5", "typescript": "^5.6.0" }
}
