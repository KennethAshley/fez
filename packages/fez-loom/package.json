{
  "name": "@fezchat/loom",
  "version": "0.2.2",
  "description": "Save, reopen, and share artifacts from any agent. Includes @loom as an optional live-tool builder.",
  "type": "module",
  "fez": {
    "type": "extension",
    "personas": {
      "dir": "personas"
    },
    "parts": {
      "gui": "dist/gui.js"
    },
    "permissions": [
      "read:channels",
      "publish",
      "personas",
      "ui"
    ]
  },
  "scripts": {
    "build": "esbuild src/gui.tsx --bundle --format=iife --global-name=__fezExt --platform=browser --jsx=automatic --outfile=dist/gui.js",
    "check": "tsc --noEmit"
  },
  "files": [
    "personas",
    "dist"
  ],
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  },
  "private": true
}
