{
  "name": "@fezchat/desktop",
  "private": true,
  "version": "0.4.41",
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && vite",
    "build": "npm run build:css && tsc && vite build",
    "build:css": "tailwindcss -c tailwind.config.js -o src/fez-utilities.css --minify",
    "prepare-pi-agent": "node scripts/prepare-pi-agent.mjs",
    "prepare-bundled-extensions": "node scripts/prepare-bundled-extensions.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-native.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fezchat/artifact-viewers": "file:../fez-artifact-viewers",
    "@fezchat/client": "file:../fez-client",
    "@fezchat/ui": "file:../fez-ui",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "highlight.js": "^11.9.0",
    "nostr-tools": "^2.24.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@fezchat/tailwind-preset": "file:../fez-tailwind-preset",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
