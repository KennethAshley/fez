<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Entitlements for the bundled bun-compiled binaries (pi, pi-acp,
     fez-relay). Bun embeds JavaScriptCore, whose JIT writes executable
     memory — under the hardened runtime that requires these two
     entitlements or the process dies on launch. The main app does NOT
     get these; only the agent binaries are signed with them. -->
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
