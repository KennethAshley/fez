{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": { "@fezchat/client": ["../fez-client/dist/index.d.ts"] }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
