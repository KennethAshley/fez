{
  "name": "@fezchat/theme-fez",
  "version": "0.1.2",
  "private": true,
  "description": "The fez theme — the landing page's palette, worn by the app. Black ground, one amber source, monospace throughout.",
  "type": "module",
  "fez": {
    "type": "extension",
    "parts": {
      "gui": "dist/gui.js"
    },
    "permissions": [
      "ui"
    ]
  },
  "scripts": {
    "build": "esbuild src/gui.ts --bundle --format=iife --global-name=__fezExt --platform=browser --outfile=dist/gui.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  }
}
