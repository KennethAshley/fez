{
  "name": "@fezchat/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "@fez \u2014 a routing orchestrator agent for fez channels, backed by any OpenAI-compatible endpoint (a cloud model, ollama, llama.cpp, or a hosted router)",
  "type": "module",
  "fez": {
    "type": "agent",
    "agent": {
      "entry": "dist/orchestrator.js",
      "supportedTasks": [
        "orchestrate"
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/orchestrator.ts --bundle --format=esm --platform=node --external:@fezchat/protocol --outfile=dist/orchestrator.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fezchat/protocol": "file:../.."
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  }
}
