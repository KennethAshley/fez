{
  "name": "@fez/notifications",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop notifications for fez events — DMs, mentions, agent failures — with pluggable delivery (herdr, macOS)",
  "type": "module",
  "fez": {
    "type": "extension",
    "extension": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  }
}
