{
  "name": "@fezchat/elevenlabs",
  "version": "0.1.2",
  "private": true,
  "description": "Agents speak — ElevenLabs TTS as a fez skill. fez_speak(channel, text) posts a voice note in the agent's own stable voice.",
  "type": "module",
  "exports": {
    "./dist/acceptance.js": {
      "types": "./src/acceptance.ts",
      "import": "./dist/acceptance.js"
    },
    "./dist/observation.js": {
      "types": "./src/observation.ts",
      "import": "./dist/observation.js"
    },
    "./dist/*": "./dist/*"
  },
  "fez": {
    "type": "extension",
    "parts": {
      "skill": {
        "command": "node",
        "args": [
          "dist/mcp.js"
        ]
      },
      "gui": "dist/gui.json"
    },
    "permissions": [
      "network:api.elevenlabs.io",
      "network:storage.googleapis.com",
      "network:relay",
      "publish",
      "read:channels",
      "read:agents",
      "ui"
    ],
    "minFezVersion": "0.2.0",
    "guiRuntime": "declarative"
  },
  "scripts": {
    "build": "esbuild src/mcp.ts src/acceptance.ts src/observation.ts --bundle --format=esm --platform=node --banner:js=\"import{createRequire as ___cr}from'module';const require=___cr(import.meta.url);\" --outdir=dist && cp src/gui.json dist/gui.json && rm -f dist/gui.js",
    "check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@fezchat/media": "file:../fez-media",
    "@fezchat/protocol": "file:../..",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "nostr-tools": "^2.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@fezchat/extension-api": "file:../fez-extension-api",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "src/acceptance.ts",
    "src/observation.ts"
  ]
}
