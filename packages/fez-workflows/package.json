{
  "name": "@fez/workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic channel automations for fez \u2014 reply-triggered handoffs and approval-by-reaction gates, Buzz's workflow engine decentralized",
  "type": "module",
  "fez": {
    "type": "agent",
    "agent": {
      "entry": "dist/workflows.js",
      "supportedTasks": [
        "workflow-automation"
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/workflows.ts --bundle --format=esm --platform=node --external:@fez/protocol --outfile=dist/workflows.js && esbuild src/defs.ts --bundle --format=esm --platform=node --outfile=dist/defs.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fez/protocol": "file:../..",
    "croner": "^10.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  }
}
