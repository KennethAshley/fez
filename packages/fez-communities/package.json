{
  "name": "@fez/communities",
  "version": "0.1.0",
  "private": true,
  "description": "Communities and channels for fez — Buzz-shaped chat over fez-native nostr kinds, with standing channel agents",
  "type": "module",
  "fez": {
    "type": "extension",
    "extension": {
      "entry": "dist/index.js"
    },
    "agent": {
      "entry": "dist/channel-agent.js",
      "supportedTasks": ["channel-chat"]
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js && esbuild src/channel-agent.ts --bundle --format=esm --platform=node --external:@fez/protocol --outfile=dist/channel-agent.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fez/protocol": "^0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  }
}
